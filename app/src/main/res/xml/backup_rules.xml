<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (API < 31).
   Backs up the team database and app preferences so records survive a phone change.
   CSV exports in the cache folder are temporary share files and are not backed up.
   Keep in sync with data_extraction_rules.xml and the privacy disclosure (AppPrivacy).
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
