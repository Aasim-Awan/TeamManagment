<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and higher (API 31+).
   Backs up the team database and app preferences so records survive a phone change.
   CSV exports in the cache folder are temporary share files and are not backed up.
   Keep in sync with backup_rules.xml and the privacy disclosure (AppPrivacy).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
